; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Juego-Puzzle"
run/main_scene="uid://bcrttrbefbqq"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[layer_names]

2d_render/layer_1="solidos"
2d_render/layer_2="danio"
2d_render/layer_3="jugador"
2d_render/layer_4="colectables"
2d_physics/layer_1="solidos"
2d_physics/layer_2="danio"
2d_physics/layer_3="jugador"
2d_physics/layer_4="recolectables"

[physics]

